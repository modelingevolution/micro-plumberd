<Project Sdk="Microsoft.NET.Sdk">
  <!-- A child process for StorePortRaceTests: two of these, started at one barrier instant, each hold a store and assert it
       stays THEIRS. Not packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicroPlumberd.Testing\MicroPlumberd.Testing.csproj" />
  </ItemGroup>
</Project>
