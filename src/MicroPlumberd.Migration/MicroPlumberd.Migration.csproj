<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType Condition="'$(Configuration)' == 'Debug'">embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Offline event-store migration / rewrite tool for KurrentDB (EventStore). Copies a source store to a fresh destination in $all commit order, applying raw (non-typed) migration rules — drop streams, drop events, rename event types, transform JSON payload/metadata, rename streams — with applied-migration history that travels with the store.</Description>
    <PackageTags>EventStore;KurrentDB;CQRS;EventSourcing;Migration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KurrentDB.Client" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.203" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MicroPlumberd.Migration.Tests" />
  </ItemGroup>

</Project>
